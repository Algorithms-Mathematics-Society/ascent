rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /candidate_access_tokens/{id} { allow read, write: if false; }
    match /_rate_limits_bot/{id} { allow read, write: if false; }
    match /_rate_limits_status_email/{id} { allow read, write: if false; }
    match /_rate_limits_status_daily/{id} { allow read, write: if false; }
    match /_rate_limits_status_exchange/{id} { allow read, write: if false; }

    match /applications/{uid} {
      // Candidate entries are server-managed; candidates do not authenticate.
      allow read, write: if false;
    }

    // Reminder emails are only accessible through the server and admin session.
    match /email_outbox/{id} {
      allow read, write: if false;
    }

    match /registration_reminders/{id} {
      allow read, write: if false;
    }

    match /_rate_limits_reminders/{id} {
      allow read, write: if false;
    }

    match /colleges/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /pii/{uid} {
      allow read, write: if false;
    }

    match /handles/{id} {
      allow read, write: if false;
    }

    match /phones/{id} {
      allow read, write: if false;
    }

    match /consent/{uid} {
      allow read, write: if false;
    }

    match /unlisted_college_submissions/{id} {
      allow read, write: if false;
    }

    match /admin_registration_decisions/{id} {
      allow read, write: if false;
    }

    match /admin_registration_operations/{id} {
      allow read, write: if false;

      match /notes/{noteId} {
        allow read, write: if false;
      }
    }

    match /admin_bulk_operations/{id} {
      allow read, write: if false;
    }

    match /admin_config/{id} {
      allow read, write: if false;
    }

    match /_rate_limits/{id} {
      allow read, write: if false;
    }

    match /_rate_limits_email/{id} {
      allow read, write: if false;
    }

    match /_rate_limits_phone/{id} {
      allow read, write: if false;
    }

    match /_rate_limits_search/{id} {
      allow read, write: if false;
    }

    match /_rate_limits_admin_auth/{id} {
      allow read, write: if false;
    }

    match /audit_log/{id} {
      allow read, write: if false;
    }

    // Written inside the decision transaction, drained server-side by the
    // Admin SDK. Listed explicitly rather than left to the default deny: it
    // names the registrants awaiting a push to AMS Access, and a collection
    // nobody has written a rule for is a collection nobody has thought about.
    match /ams_sync_outbox/{id} {
      allow read, write: if false;
    }
  }
}
