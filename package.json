{
  "name": "ams-ascent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project=ascent-2026-dev --only firestore,storage \"VITEST_RULES=true vitest run test/rules\"",
    "test:emulated": "firebase emulators:exec --project=ascent-2026-dev --only firestore,auth,storage \"VITEST_RULES=true vitest run test/rateLimit.test.ts test/rules --no-file-parallelism\"",
    "emulators": "firebase emulators:start",
    "seed:colleges": "tsx scripts/seed-colleges.ts"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "firebase-tools": "^15.24.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
